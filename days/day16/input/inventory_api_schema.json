{
    "openapi": "3.0.0",
    "info": {
        "title": "North Pole Inventory API",
        "version": "1.0.0"
    },
    "paths": {
        "/inventory": {
            "get": {
                "summary": "Check inventory for an item",
                "parameters": [
                    {
                        "name": "item_name",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string"
                                        },
                                        "stock": {
                                            "type": "integer"
                                        },
                                        "location": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}